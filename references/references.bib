}

@article{Mahapatra2026,
  title   = {Potential distribution and niche dynamics of invasive mammals},
  author  = {Mahapatra, Biswa Bhusana and Ravikanth, G. and Aravind, Neelavar Ananthram},
  journal = {Ecological Complexity},
  volume  = {66},
  pages   = {101179},
  year    = {2026},
  doi     = {10.1016/j.ecocom.2026.101179},
  note    = {FULL TEXT READ 2026-09-02. 64 invasive mammals (9 orders/25 families/48 genera), individual MaxEnt SDMs (v3.4.4), 5 km-thinned GBIF+CABI occurrences, binary suitability at 10th-percentile threshold, then simply SUMMED into a 4-category stacked map (Fig. 2: 0 / 1-10 / 11-20 / 21-30+ species per cell), current + SSP1-2.6/SSP5-8.5. This is mechanically the same "count species per cell" mechanic as this project's compounding-risk metric step, at global scale. CONFIRMED ABSENT: (1) no facilitation/meltdown framing anywhere in the paper -- framed around niche conservatism (COUE scheme) only; (2) no null-model/randomization test that stacking exceeds chance -- purely descriptive counting; (3) no validation against real documented multi-species co-occurrence records (no "primed but not yet hit" step); (4) no biodiversity/endemism overlay; (5) terrestrial mammals, not freshwater; single-algorithm MaxEnt not ensemble. This is the closest methodological precedent found in the review to date -- novelty must now rest explicitly on items (1)-(4) plus freshwater/river-network scope, not on the stacking mechanic itself.}
}

