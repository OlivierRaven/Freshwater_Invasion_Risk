# Quarto
/.quarto/
_freeze/
*_files/
index.html
index.pdf
index.docx
analysis.html

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
renv/library/
renv/local/
renv/staging/

# OS
.DS_Store

# Large / intermediate data (keep raw & derived tracked unless they get big —
# then switch to Git LFS or exclude specific large files here)
data/raw/**/*.nc
data/raw/**/*.tif
# Temp staging for FutureStreams future-scenario downloads before they move
# to the external drive -- same .nc files, belongs with the rest of
# futurestreams/ there, not in the repo
data/raw/temporary_futurestreams/
# Third-party raw data: re-download from Zenodo (see analysis.qmd section 1a)
data/raw/sinas/
# 57 MB, re-created by analysis.qmd from the raw GBIF pulls (on the external drive)
data/derived/bulk_353_gbif_occurrences_clean.csv
# 202 MB, re-created by analysis.qmd Section 4 from the data on the external drive
data/derived/occurrences_with_predictors.csv

# knitr cache / render artefacts
analysis_cache/
analysis.rmarkdown

# biomod2's own per-species model-object directories (Section 5) -- large
# (32 MB for one species, will be much larger across all 353) and fully
# regeneratable by re-running fit_prototype_sdm(); the evaluation CSVs,
# variable-importance CSVs, and suitability .tif it produces ARE tracked
# (they're small and are the actual results, not biomod2's internal state)
outputs/sdm_prototype/*/

# Publisher PDFs are copyrighted -- keep local, never publish
references/references_pdfs/

**/*.quarto_ipynb

# SDM batch run results -- committed once the full 353-species run completes,
# not during/after a partial run (avoids a misleading incomplete snapshot)
data/derived/sdm_batch_results.csv
data/derived/sdm_batch_evaluation.csv
data/derived/sdm_batch_variable_importance.csv
